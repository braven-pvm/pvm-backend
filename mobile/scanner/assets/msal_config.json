{
  "authorities": [
    {
      "type": "AAD",
      "audience": {
        "type": "AzureADMultipleOrgs"
      },
      "default": true
    }
  ],
  "authorization_user_agent": "BROWSER",
  "broker_redirect_uri_registered": false,
  "account_mode": "SINGLE",
  "multiple_clouds_supported": false,
  "shared_device_mode_supported": false,
  "http": {
    "connect_timeout": 10000,
    "read_timeout": 30000
  },
  "logging": {
    "pii_enabled": false,
    "log_level": "WARNING",
    "logcat_enabled": false
  }
}
